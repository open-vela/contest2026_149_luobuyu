<template>

    <div class="page">
  
      <div class="screen">
  
  
        <div class="topbar">
  
          <text
            class="back"
            onclick="goBack"
          >
            ‹ 返回
          </text>
  
  
          <text class="page-title">
            健康详情
          </text>
  
  
          <text class="slide-tip">
            上下滑动
          </text>
  
        </div>
  
  
  
        <swiper
          class="health-swiper"
          vertical="true"
        >
  
  
          <!-- ==================== -->
          <!-- 心率 -->
          <!-- ==================== -->
  
          <div class="slide">
  
  
            <text class="slide-title">
              心率
            </text>
  
  
            <div class="value-row">
  
              <text class="main-value">
                {{heartValue}}
              </text>
  
              <text class="unit">
                bpm
              </text>
  
            </div>
  
  
            <text class="health-status">
              {{heartStatus}}
            </text>
  
  
  
            <div class="chart-card">
  
              <chart
                class="health-chart"
                type="line"
                options="{{heartChartOpts}}"
                datasets="{{heartChartData}}"
              >
              </chart>
  
            </div>
  
  
  
            <div class="stats-row">
  
  
              <div class="stat-item">
  
                <text class="stat-label">
                  最低
                </text>
  
                <text class="stat-value">
                  {{heartMin}}
                </text>
  
              </div>
  
  
              <div class="stat-item">
  
                <text class="stat-label">
                  平均
                </text>
  
                <text class="stat-value">
                  {{heartAvg}}
                </text>
  
              </div>
  
  
              <div class="stat-item">
  
                <text class="stat-label">
                  最高
                </text>
  
                <text class="stat-value">
                  {{heartMax}}
                </text>
  
              </div>
  
  
            </div>
  
  
            <text class="sample-time">
              {{heartTime}}
            </text>
  
  
          </div>
  
  
  
          <!-- ==================== -->
          <!-- 血氧 -->
          <!-- ==================== -->
  
          <div class="slide">
  
  
            <text class="slide-title">
              血氧
            </text>
  
  
            <div class="value-row">
  
              <text class="main-value">
                {{spo2Value}}
              </text>
  
              <text class="unit">
                %
              </text>
  
            </div>
  
  
            <text class="health-status">
              {{spo2Status}}
            </text>
  
  
  
            <div class="chart-card">
  
              <chart
                class="health-chart"
                type="line"
                options="{{spo2ChartOpts}}"
                datasets="{{spo2ChartData}}"
              >
              </chart>
  
            </div>
  
  
  
            <div class="stats-row">
  
  
              <div class="stat-item">
  
                <text class="stat-label">
                  最低
                </text>
  
                <text class="stat-value">
                  {{spo2Min}}
                </text>
  
              </div>
  
  
              <div class="stat-item">
  
                <text class="stat-label">
                  平均
                </text>
  
                <text class="stat-value">
                  {{spo2Avg}}
                </text>
  
              </div>
  
  
              <div class="stat-item">
  
                <text class="stat-label">
                  最高
                </text>
  
                <text class="stat-value">
                  {{spo2Max}}
                </text>
  
              </div>
  
  
            </div>
  
  
            <text class="sample-time">
              {{spo2Time}}
            </text>
  
  
          </div>
  
  
  
          <!-- ==================== -->
          <!-- 压力 -->
          <!-- ==================== -->
  
          <div class="slide">
  
  
            <text class="slide-title">
              压力
            </text>
  
  
            <div class="value-row">
  
              <text class="main-value">
                {{stressValue}}
              </text>
  
            </div>
  
  
            <text class="health-status">
              {{stressStatus}}
            </text>
  
  
  
            <div class="chart-card">
  
              <chart
                class="health-chart"
                type="line"
                options="{{stressChartOpts}}"
                datasets="{{stressChartData}}"
              >
              </chart>
  
            </div>
  
  
  
            <div class="stats-row">
  
  
              <div class="stat-item">
  
                <text class="stat-label">
                  最低
                </text>
  
                <text class="stat-value">
                  {{stressMin}}
                </text>
  
              </div>
  
  
              <div class="stat-item">
  
                <text class="stat-label">
                  平均
                </text>
  
                <text class="stat-value">
                  {{stressAvg}}
                </text>
  
              </div>
  
  
              <div class="stat-item">
  
                <text class="stat-label">
                  最高
                </text>
  
                <text class="stat-value">
                  {{stressMax}}
                </text>
  
              </div>
  
  
            </div>
  
  
            <text class="sample-time">
              {{stressTime}}
            </text>
  
  
          </div>
  
  
        </swiper>
  
  
      </div>
  
    </div>
  
  </template>
  
  
  
  <style>
  
  
  .page {
  
    width: 100%;
    height: 100%;
  
    flex-direction: column;
  
    justify-content: flex-start;
    align-items: flex-start;
  
    background-color: #F8F5E1;
  
    overflow: hidden;
  
  }
  
  
  
  .screen {
  
    width: 390px;
    height: 450px;
  
    flex-direction: column;
  
    justify-content: flex-start;
    align-items: center;
  
    background-color: #F8F5E1;
  
    overflow: hidden;
  
  }
  
  
  
  .topbar {
  
    width: 350px;
    height: 42px;
  
    margin-top: 5px;
  
    flex-direction: row;
  
    align-items: center;
    justify-content: space-between;
  
  }
  
  
  
  .back {
  
    width: 90px;
  
    font-size: 15px;
  
    color: #77746C;
  
  }
  
  
  
  .page-title {
  
    width: 140px;
  
    font-size: 18px;
  
    font-weight: bold;
  
    text-align: center;
  
    color: #20201D;
  
  }
  
  
  
  .slide-tip {
  
    width: 90px;
  
    font-size: 12px;
  
    text-align: right;
  
    color: #9A968E;
  
  }
  
  
  
  .health-swiper {
  
    width: 390px;
    height: 400px;
  
    background-color: #F8F5E1;
  
    indicator-color: #C8C2B2;
  
    indicator-selected-color: #20201D;
  
    indicator-size: 5px;
  
    indicator-right: 7px;
  
  }
  
  
  
  .slide {
  
    width: 390px;
    height: 400px;
  
    flex-direction: column;
  
    align-items: center;
  
    background-color: #F8F5E1;
  
  }
  
  
  
  .slide-title {
  
    margin-top: 7px;
  
    font-size: 24px;
  
    font-weight: bold;
  
    color: #20201D;
  
  }
  
  
  
  .value-row {
  
    height: 72px;
  
    margin-top: 4px;
  
    flex-direction: row;
  
    justify-content: center;
    align-items: center;
  
  }
  
  
  
  .main-value {
  
    font-size: 58px;
  
    font-weight: bold;
  
    color: #20201D;
  
  }
  
  
  
  .unit {
  
    margin-left: 7px;
    margin-top: 23px;
  
    font-size: 17px;
  
    color: #77746C;
  
  }
  
  
  
  .health-status {
  
    margin-top: -2px;
  
    font-size: 16px;
  
    color: #7D9B73;
  
  }
  
  
  
  .chart-card {
  
    width: 320px;
    height: 155px;
  
    margin-top: 9px;
  
    justify-content: center;
    align-items: center;
  
    background-color: #F1ECD8;
  
    border-radius: 18px;
  
  }
  
  
  
  .health-chart {
  
    width: 300px;
    height: 135px;
  
  }
  
  
  
  .stats-row {
  
    width: 300px;
    height: 55px;
  
    margin-top: 8px;
  
    flex-direction: row;
  
    justify-content: space-between;
  
  }
  
  
  
  .stat-item {
  
    width: 90px;
    height: 52px;
  
    flex-direction: column;
  
    justify-content: center;
    align-items: center;
  
  }
  
  
  
  .stat-label {
  
    font-size: 12px;
  
    color: #918D84;
  
  }
  
  
  
  .stat-value {
  
    margin-top: 2px;
  
    font-size: 18px;
  
    font-weight: bold;
  
    color: #20201D;
  
  }
  
  
  
  .sample-time {
  
    margin-top: 3px;
  
    font-size: 12px;
  
    color: #A09B91;
  
  }
  
  
  </style>
  
  
  
  <script>
  
  
  import router from '@system.router'
  
  
  import {
  
    getRecent,
  
    subscribe,
  
    unsubscribe,
  
    DATA_TYPES
  
  } from '../../common/health.js'
  
  
  import vitals from
    '../../common/vitals.js'
  
  
  
  const WINDOW_SIZE =
    30
  
  
  
  const ALL_TYPES = [
  
    DATA_TYPES.HEART_RATE,
  
    DATA_TYPES.SPO2,
  
    DATA_TYPES.STRESS
  
  ]
  
  
  
  export default {
  
  
    data: {
  
  
      heartPoints:
        [],
  
  
      spo2Points:
        [],
  
  
      stressPoints:
        [],
  
  
  
      heartValue:
        "--",
  
  
      heartStatus:
        "等待数据",
  
  
      heartMin:
        "--",
  
  
      heartAvg:
        "--",
  
  
      heartMax:
        "--",
  
  
      heartTime:
        "",
  
  
  
      spo2Value:
        "--",
  
  
      spo2Status:
        "等待数据",
  
  
      spo2Min:
        "--",
  
  
      spo2Avg:
        "--",
  
  
      spo2Max:
        "--",
  
  
      spo2Time:
        "",
  
  
  
      stressValue:
        "--",
  
  
      stressStatus:
        "等待数据",
  
  
      stressMin:
        "--",
  
  
      stressAvg:
        "--",
  
  
      stressMax:
        "--",
  
  
      stressTime:
        "",
  
  
  
      heartChartOpts: {
  
        xAxis: {
  
          min:
            0,
  
          max:
            WINDOW_SIZE - 1,
  
          display:
            false
  
        },
  
        yAxis: {
  
          min:
            40,
  
          max:
            180,
  
          display:
            false
  
        }
  
      },
  
  
  
      spo2ChartOpts: {
  
        xAxis: {
  
          min:
            0,
  
          max:
            WINDOW_SIZE - 1,
  
          display:
            false
  
        },
  
        yAxis: {
  
          min:
            80,
  
          max:
            100,
  
          display:
            false
  
        }
  
      },
  
  
  
      stressChartOpts: {
  
        xAxis: {
  
          min:
            0,
  
          max:
            WINDOW_SIZE - 1,
  
          display:
            false
  
        },
  
        yAxis: {
  
          min:
            0,
  
          max:
            100,
  
          display:
            false
  
        }
  
      },
  
  
  
      heartChartData: [
  
        {
  
          strokeColor:
            "#20201D",
  
          fillColor:
            "#20201D",
  
          gradient:
            false,
  
          data:
            []
  
        }
  
      ],
  
  
  
      spo2ChartData: [
  
        {
  
          strokeColor:
            "#7D9B73",
  
          fillColor:
            "#7D9B73",
  
          gradient:
            false,
  
          data:
            []
  
        }
  
      ],
  
  
  
      stressChartData: [
  
        {
  
          strokeColor:
            "#A98756",
  
          fillColor:
            "#A98756",
  
          gradient:
            false,
  
          data:
            []
  
        }
  
      ],
  
  
  
      healthActive:
        false
  
    },
  
  
  
    onReady() {
  
      this.startHealth()
  
    },
  
  
  
    onDestroy() {
  
      this.stopHealth()
  
    },
  
  
  
    /*
     * 返回主页
     */
    goBack() {
  
      router.back()
  
    },
  
  
  
    /*
     * 开启健康详情数据
     */
    startHealth() {
  
  
      if (
        this.healthActive
      ) {
  
        return
  
      }
  
  
      this.healthActive =
        true
  
  
      getRecent(
        ALL_TYPES
      )
      .then((list) => {
  
  
        for (
          let i = 0;
          i < list.length;
          i++
        ) {
  
          this.applySample(
            list[i]
          )
  
        }
  
      })
  
  
  
      for (
        let i = 0;
        i < ALL_TYPES.length;
        i++
      ) {
  
        let type =
          ALL_TYPES[i]
  
  
        subscribe(
  
          type,
  
          (sample) => {
  
            this.applySample(
              sample
            )
  
          },
  
          (error) => {
  
            this.applyError(
              error
            )
  
          }
  
        )
  
      }
  
    },
  
  
  
    /*
     * 停止订阅
     */
    stopHealth() {
  
  
      if (
        !this.healthActive
      ) {
  
        return
  
      }
  
  
      for (
        let i = 0;
        i < ALL_TYPES.length;
        i++
      ) {
  
        unsubscribe(
          ALL_TYPES[i]
        )
  
      }
  
  
      this.healthActive =
        false
  
    },
  
  
  
    /*
     * 接收一条健康数据
     */
    applySample(sample) {
  
  
      if (
        !sample ||
        !sample.ok
      ) {
  
        return
  
      }
  
  
  
      if (
        sample.dataType ===
        DATA_TYPES.HEART_RATE
      ) {
  
        this.updateHeart(
          sample
        )
  
      }
  
  
  
      else if (
        sample.dataType ===
        DATA_TYPES.SPO2
      ) {
  
        this.updateSpo2(
          sample
        )
  
      }
  
  
  
      else if (
        sample.dataType ===
        DATA_TYPES.STRESS
      ) {
  
        this.updateStress(
          sample
        )
  
      }
  
    },
  
  
  
    /*
     * 心率
     */
    updateHeart(sample) {
  
  
      let value =
        Math.round(
          sample.value
        )
  
  
      this.heartPoints =
        vitals.pushWindow(
  
          this.heartPoints,
  
          value,
  
          WINDOW_SIZE
  
        )
  
  
      let stat =
        vitals.stats(
          this.heartPoints
        )
  
  
      this.heartValue =
        ""
        + value
  
  
      this.heartStatus =
        vitals.heartStatus(
          value
        )
  
  
      this.heartMin =
        ""
        + stat.min
  
  
      this.heartAvg =
        ""
        + stat.avg
  
  
      this.heartMax =
        ""
        + stat.max
  
  
      this.heartTime =
        this.formatSampleTime(
          sample.timeStamp
        )
  
  
      this.heartChartData = [
  
        {
  
          strokeColor:
            "#20201D",
  
          fillColor:
            "#20201D",
  
          gradient:
            false,
  
          data:
            this.heartPoints.slice()
  
        }
  
      ]
  
    },
  
  
  
    /*
     * 血氧
     */
    updateSpo2(sample) {
  
  
      let value =
        Math.round(
          sample.value
        )
  
  
      this.spo2Points =
        vitals.pushWindow(
  
          this.spo2Points,
  
          value,
  
          WINDOW_SIZE
  
        )
  
  
      let stat =
        vitals.stats(
          this.spo2Points
        )
  
  
      this.spo2Value =
        ""
        + value
  
  
      this.spo2Status =
        vitals.spo2Status(
          value
        )
  
  
      this.spo2Min =
        ""
        + stat.min
  
  
      this.spo2Avg =
        ""
        + stat.avg
  
  
      this.spo2Max =
        ""
        + stat.max
  
  
      this.spo2Time =
        this.formatSampleTime(
          sample.timeStamp
        )
  
  
      this.spo2ChartData = [
  
        {
  
          strokeColor:
            "#7D9B73",
  
          fillColor:
            "#7D9B73",
  
          gradient:
            false,
  
          data:
            this.spo2Points.slice()
  
        }
  
      ]
  
    },
  
  
  
    /*
     * 压力
     */
    updateStress(sample) {
  
  
      let value =
        Math.round(
          sample.value
        )
  
  
      this.stressPoints =
        vitals.pushWindow(
  
          this.stressPoints,
  
          value,
  
          WINDOW_SIZE
  
        )
  
  
      let stat =
        vitals.stats(
          this.stressPoints
        )
  
  
      this.stressValue =
        ""
        + value
  
  
      this.stressStatus =
        vitals.stressStatus(
          value
        )
  
  
      this.stressMin =
        ""
        + stat.min
  
  
      this.stressAvg =
        ""
        + stat.avg
  
  
      this.stressMax =
        ""
        + stat.max
  
  
      this.stressTime =
        this.formatSampleTime(
          sample.timeStamp
        )
  
  
      this.stressChartData = [
  
        {
  
          strokeColor:
            "#A98756",
  
          fillColor:
            "#A98756",
  
          gradient:
            false,
  
          data:
            this.stressPoints.slice()
  
        }
  
      ]
  
    },
  
  
  
    /*
     * 健康接口异常
     */
    applyError(error) {
  
  
      if (!error) {
  
        return
  
      }
  
  
      console.log(
  
        "health detail error:",
  
        vitals.codeMessage(
          error.code
        )
  
      )
  
    },
  
  
  
    /*
     * 显示采样时间
     */
    formatSampleTime(
      timeStamp
    ) {
  
  
      if (
        !timeStamp
      ) {
  
        return ""
  
      }
  
  
      let date =
        new Date(
          timeStamp
        )
  
  
      let hour =
        date.getHours()
  
  
      let minute =
        date.getMinutes()
  
  
      let second =
        date.getSeconds()
  
  
  
      let hh =
        hour < 10
        ? "0" + hour
        : "" + hour
  
  
      let mm =
        minute < 10
        ? "0" + minute
        : "" + minute
  
  
      let ss =
        second < 10
        ? "0" + second
        : "" + second
  
  
  
      return (
  
        "更新时间 "
        + hh
        + ":"
        + mm
        + ":"
        + ss
  
      )
  
    }
  
  
  }
  
  
  </script>