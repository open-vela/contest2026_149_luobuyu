{
  "package": "com.application.aliveguardian",
  "name": "alive_guardian",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    {
      "name": "system.storage"
    },
    {
      "name": "system.velaclaw"
    },
    {
      "name": "system.router"
    },
    {
      "name": "service.health"
    }
  ],
  "permissions": [
    {
      "name": "hapjs.permission.HEALTH"
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 390,
    "background": {
      "features": [
        "service.health"
      ]
    }
  },
  "router": {
    "entry": "pages/splash",
    "pages": {
      "pages/splash": {
        "component": "index"
      },
      "pages/index": {
        "component": "index"
      },
      "pages/detail": {
        "component": "index"
      },
      "pages/ai": {
        "component": "index"
      }
    }
  }
}